<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MahjongAI" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Fallback window background for Android 11 and lower -->
        <item name="android:windowBackground">@color/dark_green</item>

        <!-- System splash screen background for Android 12+ (API 31+) -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/dark_green</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/mahjong_splash_icon</item>
    </style>

    <style name="Theme.MyGame" parent="Theme.MahjongAI" />
</resources>